# Server Port
PORT=5000
NODE_ENV=development

# Database Settings (TiDB Cloud Starter or Local MySQL)
# For TiDB Cloud Starter:
# DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=shop_app
DB_SSL=false

# Authentication Secrets
JWT_SECRET=ecommerce_jwt_access_secret_key_2026_dev
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=ecommerce_jwt_refresh_secret_key_2026_dev
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay test keys)
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=rzp_test_sample_secret

# Image Storage (Cloudflare R2 / S3 compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shop-app-images
R2_PUBLIC_URL=https://images.example.com
